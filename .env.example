# Referência de variáveis. Para dotnet run, exporte as variáveis no terminal ou use User Secrets.
# O Docker Compose lê POSTGRES_PASSWORD do ambiente ou de um .env local (ignorado pelo Git).
POSTGRES_PASSWORD=
ConnectionStrings__DefaultConnection=
Jwt__Key=
Database__ApplyMigrations=false
Database__SeedDemoData=false
Demo__Password=
Services__AiHealthUrl=
Push__Enabled=false
Push__AccessToken=

